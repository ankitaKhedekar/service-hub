# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# Local: mongodb://127.0.0.1:27017/service_hub
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/service_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/service_hub

# Use a long random string (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:4200

# Business settings
APP_TIMEZONE=Asia/Kolkata
CANCEL_CUTOFF_HOURS=2
BOOKING_WINDOW_DAYS=30

# Password given to every demo account created by `npm run seed`
SEED_PASSWORD=change-me-123
